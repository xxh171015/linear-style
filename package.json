{
  "name": "linear-style",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "server": "tsx server/main.ts",
    "server:start": "pnpm build && tsx server/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "sandcastle": "tsx .sandcastle/main.mts",
    "desktop": "pnpm build && electron .",
    "desktop:dev": "REPLICA_DEV_URL=http://127.0.0.1:5174 electron .",
    "desktop:smoke": "pnpm build && electron . --smoke-test",
    "desktop:package": "pnpm build && node desktop/package.mjs"
  },
  "dependencies": {
    "@tiptap/core": "3.34.0",
    "@tiptap/extension-details": "3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/extension-table": "3.34.0",
    "@tiptap/extension-task-item": "^3.34.0",
    "@tiptap/extension-task-list": "^3.34.0",
    "@tiptap/markdown": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "^0.13.0",
    "@electron/packager": "^20.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^45.3.4",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "electron"
    ]
  },
  "main": "desktop/main.mjs"
}
