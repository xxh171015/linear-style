{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023", "DOM"], "module": "ESNext",
    "moduleResolution": "bundler", "noEmit": true, "strict": true,
    "skipLibCheck": true, "types": ["node"], "esModuleInterop": true,
    "erasableSyntaxOnly": true
  },
  "include": ["server/**/*.ts"]
}
